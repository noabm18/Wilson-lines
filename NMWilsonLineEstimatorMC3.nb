Cell[BoxData[
 RowBox[{
  RowBox[{"WapproxHoriz", "[", 
   RowBox[{"y_", ",", "rot_", ",", "rr_"}], "]"}], ":=", 
  RowBox[{"Dot", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"W2", "[", 
      RowBox[{"Arot", "[", 
       RowBox[{"y", "+", 
        RowBox[{"rot", ".", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", 
               RowBox[{"1", "/", "2"}]}], ")"}], 
             RowBox[{"rr", "/", "n"}]}], "-", 
            RowBox[{"rr", "/", "2"}]}], ",", "0", ",", "0", ",", 
           RowBox[{"L", "/", "2"}]}], "}"}]}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}]], "Input",
