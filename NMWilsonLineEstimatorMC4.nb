         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", 
               RowBox[{"1", "/", "2"}]}], ")"}], 
             RowBox[{"rr", "/", "n"}]}], "-", 
            RowBox[{"rr", "/", "2"}]}], ",", "0", ",", "0", ",", 
           RowBox[{"L", "/", "2"}]}], "}"}]}]}], "]"}], "]"}], ",", 
