Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ImesBB0", "[", 
   RowBox[{"y_", ",", "rot_", ",", "rr_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"L", "/", "n"}], ")"}], "^", "2"}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"B", "[", 
           RowBox[{
            RowBox[{"y", "+", 
             RowBox[{"rot", ".", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"rr", "/", "2"}], ",", "0", ",", "0", ",", "0"}], 
               "}"}]}], "+", 
             RowBox[{"rot", ".", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0", ",", "t1"}], "}"}]}]}], ",", 
            "rot"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", ",", 
         RowBox[{"{", 
          RowBox[{"t1", ",", 
           RowBox[{"L", "/", "n"}], ",", "L", ",", 
           RowBox[{"L", "/", "n"}]}], "}"}]}], "]"}], ".", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"B", "[", 
           RowBox[{
            RowBox[{"y", "-", 
             RowBox[{"rot", ".", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"rr", "/", "2"}], ",", "0", ",", "0", ",", "0"}], 
               "}"}]}], "+", 
             RowBox[{"rot", ".", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0", ",", "t2"}], "}"}]}]}], ",", 
            "rot"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
