Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Field", " ", "Strength"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Fmunu", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Arat", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"y", "[", "1", "]"}], ",", 
                RowBox[{"y", "[", "2", "]"}], ",", 
                RowBox[{"y", "[", "3", "]"}], ",", 
                RowBox[{"y", "[", "4", "]"}]}], "}"}], "]"}], "[", 
             RowBox[{"[", "mu", "]"}], "]"}], "[", 
            RowBox[{"[", "a", "]"}], "]"}], ",", 
           RowBox[{"y", "[", "nu", "]"}]}], " ", "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Arat", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"y", "[", "1", "]"}], ",", 
                RowBox[{"y", "[", "2", "]"}], ",", 
                RowBox[{"y", "[", "3", "]"}], ",", 
                RowBox[{"y", "[", "4", "]"}]}], "}"}], "]"}], "[", 
             RowBox[{"[", "nu", "]"}], "]"}], "[", 
            RowBox[{"[", "a", "]"}], "]"}], ",", 
           RowBox[{"y", "[", "mu", "]"}]}], " ", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mu", ",", "1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"nu", ",", "1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "1", ",", "3"}], "}"}]}], "]"}], "+", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sum", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "[", 
             RowBox[{"[", 
